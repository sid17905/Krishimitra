# KrishiMitra Environment Variables Template
# Copy this file to '.env' and fill in your actual API keys.

# LLM Providers (for AI Voice Companion & Diagnosis)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Live Weather (free key at https://openweathermap.org/api)
# If left empty/default, the app falls back to realistic cached data.
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Live Mandi Prices (free key at https://data.gov.in)
# If left empty/default, the app falls back to bundled Agmarknet data.
DATA_GOV_API_KEY=your_data_gov_api_key_here
